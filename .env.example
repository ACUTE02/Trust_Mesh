# Copy to .env (which is git-ignored) and edit. docker compose reads .env automatically.
# Nothing here is a real secret. Never commit a .env file.

# Neo4j password. "trustmesh-demo" is only the default for a stack bound to 127.0.0.1.
# For any deployment reachable from outside this machine, set a new, long, random value.
# (If Neo4j already has a data volume from an earlier password, remove the volume or change the
# password inside Neo4j: NEO4J_AUTH only applies when the database is first created.)
NEO4J_PASSWORD=change-me

# Browser origins allowed to call the API directly (comma-separated). The bundled frontend proxies /api,
# so in a deployment this is just the public frontend origin.
TRUSTMESH_CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Upload and rate limits for the scoring endpoints.
TRUSTMESH_MAX_UPLOAD_MB=10
TRUSTMESH_MAX_AUDIO_SECONDS=60
TRUSTMESH_RATE_LIMIT_PER_MINUTE=30

# Recording mode: 1 makes the site hide real transaction numbers, labels and scores on the graph desks,
# so a video can show the flow without publishing them. The voice desk is not affected.
TRUSTMESH_RECORDING_MODE=0

# Deployment only (docker-compose.deploy.yml): the host port the frontend is published on.
PUBLIC_PORT=80
